PORT=3000
NODE_ENV=development

MONGO_URI=mongodb://mongo:27017/silver_gateway
REDIS_URL=redis://redis:6379

# Rate limiting defaults
RATE_LIMIT_DEFAULT_LIMIT=1000
RATE_LIMIT_DEFAULT_WINDOW_SEC=60

# Usage logging
USAGE_LOG_BATCH_SIZE=200
USAGE_LOG_FLUSH_INTERVAL_MS=2000

# Plugins
PLUGINS_DIR=./plugins
PLUGIN_TIMEOUT_MS=500

# API Key settings
API_KEY_PREFIX=sgk_
API_KEY_SECRET_BYTES=32

# JWT verification
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URI=
JWT_SECRET=
JWT_ALGORITHMS=HS256
